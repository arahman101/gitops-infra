{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowReadRedisAppSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": [
        "arn:aws:secretsmanager:eu-west-2:*:secret:redis-app/dev/redis-*",
        "arn:aws:secretsmanager:eu-west-2:*:secret:redis-app/prod/redis-*"
      ]
    }
  ]
}